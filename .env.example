# Database (PostgreSQL + pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_widget_db
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_secure_password

# Vector Configuration & Embedding Provider
VECTOR_DIMENSION=1536
EMBEDDING_PROVIDER=ollama # Options: mock | openai | ollama

# Ollama Embedding Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text
OLLAMA_PORT=11434

# LLM Generation Provider
LLM_PROVIDER=gemini # Options: mock | ollama | gemini | groq | openai
LLM_MODEL=gemini-3.8-flash # Options: gemini-3.8-flash | gemini-3.5-flash | llama3.2:1b
GEMINI_API_KEY=AQ.Ab8RN6Ih7n3HK16p0v6uerwXGc23whGYBCGyO1p4pkZ8C56i5g
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# LLM Generation Provider
LLM_PROVIDER=gemini # Options: mock | ollama | gemini | groq | openai
LLM_MODEL=gemini-3.8-flash # Options: gemini-3.8-flash | gemini-3.5-flash | llama3.2:1b
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Cache & Queue (Redis)
REDIS_HOST=localhost
REDIS_PORT=6380

# Ingestion & CDC
CDC_CHANNEL=rag_cdc_channel
CDC_QUEUE_NAME=cdc-mutations
CDC_DEBOUNCE_MS=500
CDC_MAX_RETRIES=5

# Application Environment
NODE_ENV=development
