# Database (PostgreSQL + pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_widget_db
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_secure_password

# Vector Configuration & Embedding Provider
VECTOR_DIMENSION=1536
EMBEDDING_PROVIDER=mock # Options: mock | openai | ollama

# Ollama Configuration (when EMBEDDING_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text
OLLAMA_PORT=11434

# Cache & Queue (Redis)
REDIS_HOST=localhost
REDIS_PORT=6380

# Ingestion & CDC
CDC_CHANNEL=rag_cdc_channel
CDC_QUEUE_NAME=cdc-mutations
CDC_DEBOUNCE_MS=500
CDC_MAX_RETRIES=5

# Application Environment
NODE_ENV=development

