{
  "name": "db-native-rag-widget",
  "version": "0.1.0",
  "description": "Privacy-first, real-time RAG widget syncing directly from databases via CDC",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "cdc:listen": "tsx src/ingestion/listener.ts",
    "migrate": "tsx src/database/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "docker:build": "npm run docker:build:prod",
    "docker:build:dev": "docker build --target development -t db-native-rag-widget:dev .",
    "docker:build:prod": "docker build --target production -t db-native-rag-widget:latest .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "bullmq": "^6.5.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
